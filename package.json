{
  "name": "sonascribe",
  "version": "0.4.1",
  "description": "Local-first audio transcription with timestamps and automatic speaker detection",
  "main": "./out/main/index.js",
  "author": "pauyon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "smoke": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --dir --config electron-builder.config.cjs",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.config.cjs",
    "sidecars": "node scripts/fetch-sidecars.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "electron": "^42.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
