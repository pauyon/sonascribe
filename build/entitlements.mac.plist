<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Microphone capture. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- Electron ships a V8 JIT; the hardened runtime blocks it without these. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- The ML sidecars (whisper.cpp, sherpa-onnx) are separately-signed binaries
       spawned as child processes; without this the hardened runtime refuses to
       load libraries they are signed with. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
